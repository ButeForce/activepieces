        "jsCode": "const out = [];\nfor (const item of items) {\n  const data = item.json.data || item.json.embedding || [];\n  let embedding = [];\n  if (Array.isArray(data) && data[0] && data[0].embedding) {\n    embedding = data[0].embedding;\n  } else if (Array.isArray(item.json.embedding)) {\n    embedding = item.json.embedding;\n  }\n  out.push({ json: { ...item.json, embedding } });\n}\nreturn out;"
