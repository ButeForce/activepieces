        "jsCode": "function normalizeArabic(input) {\n  if (!input) return '';\n  let s = String(input);\n  s = s.replace(/[\u064B-\u0652]/g, '');\n  s = s.replace(/\u0640/g, '');\n  s = s.replace(/[???]/g, '?');\n  s = s.replace(/?/g, '?');\n  s = s.replace(/\s+/g, ' ').trim();\n  return s;\n}\n\nconst q = items[0].json.question || items[0].json.q || items[0].json.text || '';\nreturn [{ json: { question: q, normalizedQuestion: normalizeArabic(q) } }];"
